@*
Họ và tên: Đào Hoàng An
Mã sinh viên: [23103100074]
Nội dung thực hiện: Module 3 - Chi tiết đăng ký đề tài của sinh viên (mục 7.5)
*@

@model QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.DangKyDeTai
@using QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Common

@{
    ViewData["Title"] = "Chi tiết đăng ký";
    var lichSu = ViewData["LichSuPhanCong"] as IEnumerable<QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.PhanCongHuongDan>
                 ?? Array.Empty<QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.PhanCongHuongDan>();
}

<div class="container mt-4">
    <h2>Chi tiết đăng ký đề tài</h2>
    <hr />

    <div class="card mb-4">
        <div class="card-header bg-light fw-bold">Thông tin đề tài</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Mã đề tài</dt>
                <dd class="col-sm-9">@Model.MaDeTai</dd>

                <dt class="col-sm-3">Tên đề tài</dt>
                <dd class="col-sm-9 fw-bold">@(Model.DeTai?.TenDeTai ?? "-")</dd>

                <dt class="col-sm-3">Lĩnh vực</dt>
                <dd class="col-sm-9">@(Model.DeTai?.LinhVuc?.TenLinhVuc ?? "-")</dd>

                <dt class="col-sm-3">Năm học / Học kỳ</dt>
                <dd class="col-sm-9">
                    @(Model.DeTai == null ? "-" : $"{Model.DeTai.NamHoc} - Học kỳ {Model.DeTai.HocKy}")
                </dd>

                <dt class="col-sm-3">Số lượng tối đa</dt>
                <dd class="col-sm-9">@(Model.DeTai?.SoSinhVienToiDa ?? 0) sinh viên</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light fw-bold">Thông tin đăng ký</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Mã đăng ký</dt>
                <dd class="col-sm-9">@Model.MaDangKy</dd>

                <dt class="col-sm-3">Ngày đăng ký</dt>
                <dd class="col-sm-9">@Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Lý do đăng ký</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.LyDoDangKy) ? "-" : Model.LyDoDangKy)</dd>

                <dt class="col-sm-3">Trạng thái đăng ký</dt>
                <dd class="col-sm-9 fw-bold">@TrangThaiHeThong.DangKyDeTai.HienThi(Model.TrangThai)</dd>

                <dt class="col-sm-3">Trạng thái thực hiện</dt>
                <dd class="col-sm-9 fw-bold">@TrangThaiHeThong.TrangThaiThucHien.HienThi(Model.TrangThaiThucHien)</dd>

                <dt class="col-sm-3">Ghi chú của Admin</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.GhiChuDuyet) ? "-" : Model.GhiChuDuyet)</dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light fw-bold">Lịch sử phân công giảng viên hướng dẫn</div>
        <div class="card-body">
            @if (!lichSu.Any())
            {
                <p class="text-muted mb-0">Đăng ký này chưa được phân công giảng viên hướng dẫn.</p>
            }
            else
            {
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>Giảng viên</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pc in lichSu)
                        {
                            <tr>
                                <td>@(pc.GiangVien?.HoTen ?? "-")</td>
                                <td>@pc.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                <td>@(pc.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@TrangThaiHeThong.PhanCongHuongDan.HienThi(pc.TrangThai)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="mt-3">
        @if (Model.TrangThai == TrangThaiHeThong.DangKyDeTai.ChoDuyet)
        {
            <a class="btn btn-outline-danger text-danger" asp-action="HuyDangKy" asp-route-maDangKy="@Model.MaDangKy">Hủy đăng ký</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại lịch sử</a>
    </div>
</div>