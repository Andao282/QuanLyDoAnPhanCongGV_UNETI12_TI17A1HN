@*
Họ và tên: Đào Hoàng An
Mã sinh viên: [23103100074]
Nội dung thực hiện: Module 4 - Dashboard tổng quan (mục 8.7)
*@

@{
    ViewData["Title"] = "Dashboard";
    var s = ViewData["SoLieu"] as QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.DashboardSoLieu
            ?? new QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.DashboardSoLieu();
    var theoLinhVuc = ViewData["DeTaiTheoLinhVuc"] as List<QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.ThongKeDeTaiTheoLinhVuc>
                      ?? new List<QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.ThongKeDeTaiTheoLinhVuc>();
    var theoTrangThai = ViewData["DangKyTheoTrangThai"] as List<QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.ThongKeDangKyTheoTrangThai>
                        ?? new List<QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.ThongKeDangKyTheoTrangThai>();
    var tongDk = theoTrangThai.Sum(x => x.SoLuong);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Dashboard tổng quan</h2>
        <a asp-controller="ThongKe" asp-action="Index" class="btn btn-outline-primary">Xem thống kê chi tiết</a>
    </div>
    <hr />

    @* Nhóm thẻ: tổng số lĩnh vực, giảng viên, sinh viên, đề tài (mục 8.7) *@
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <div class="fs-3 fw-bold text-primary">@s.TongLinhVuc</div>
                    <div class="text-muted">Lĩnh vực nghiên cứu</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center border-success">
                <div class="card-body">
                    <div class="fs-3 fw-bold text-success">@s.TongGiangVien</div>
                    <div class="text-muted">Giảng viên</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center border-info">
                <div class="card-body">
                    <div class="fs-3 fw-bold text-info">@s.TongSinhVien</div>
                    <div class="text-muted">Sinh viên</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <div class="fs-3 fw-bold text-warning">@s.TongDeTai</div>
                    <div class="text-muted">Đề tài</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4 fw-bold">@s.SoDangKyChoDuyet</div>
                    <div class="text-muted">Đăng ký chờ duyệt</div>
                    <a asp-controller="DuyetDangKys" asp-action="Index" class="small">Xem danh sách</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4 fw-bold">@s.SoDangKyDaDuyet</div>
                    <div class="text-muted">Đăng ký đã duyệt</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4 fw-bold">@s.SoDeTaiConCho</div>
                    <div class="text-muted">Đề tài còn chỗ</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-4 fw-bold">@s.SoDeTaiDuSoLuong</div>
                    <div class="text-muted">Đề tài đủ số lượng</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light fw-bold">Phân bố đăng ký theo trạng thái</div>
                <div class="card-body">
                    @if (tongDk == 0)
                    {
                        <p class="text-muted mb-0">Chưa có đăng ký nào.</p>
                    }
                    else
                    {
                        @foreach (var item in theoTrangThai.OrderByDescending(x => x.SoLuong))
                        {
                            var pct = tongDk == 0 ? 0 : Math.Round(item.SoLuong * 100.0 / tongDk, 1);
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span>@QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Common.TrangThaiHeThong.DangKyDeTai.HienThi(item.TrangThai)</span>
                                    <span class="fw-bold">@item.SoLuong (@pct%)</span>
                                </div>
                                @* Thanh tiến trình: thanh phần trăm tính từ LINQ ở trên *@
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-secondary" style="width: @pct%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light fw-bold">Số đề tài theo lĩnh vực</div>
                <div class="card-body">
                    @if (theoLinhVuc.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có đề tài nào.</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Lĩnh vực</th>
                                    <th class="text-center">Số đề tài</th>
                                    <th class="text-center" style="width: 45%;">Tỷ trọng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in theoLinhVuc)
                                {
                                    var pct = s.TongDeTai == 0 ? 0 : Math.Round(item.SoDeTai * 100.0 / s.TongDeTai, 1);
                                    <tr>
                                        <td>@item.TenLinhVuc</td>
                                        <td class="text-center fw-bold">@item.SoDeTai</td>
                                        <td>
                                            <div class="progress" style="height: 10px;">
                                                <div class="progress-bar bg-primary" style="width: @pct%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light fw-bold">Tình hình giảng viên hướng dẫn</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Sinh viên đang có giảng viên hướng dẫn</span>
                            <span class="fw-bold">@s.SoSinhVienDangCoGiangVien</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Giảng viên đã đạt giới hạn hướng dẫn</span>
                            <span class="fw-bold text-danger">@s.SoGiangVienDatGioiHan</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Giảng viên còn nhận sinh viên</span>
                            <span class="fw-bold text-success">@(s.TongGiangVien - s.SoGiangVienDatGioiHan)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header bg-light fw-bold">Việc cần xử lý</div>
                <div class="card-body d-flex flex-column gap-2">
                    <a asp-controller="DuyetDangKys" asp-action="Index" class="btn btn-outline-warning text-start">
                        Duyệt đăng ký đang chờ
                        <span class="badge bg-warning text-dark float-end">@s.SoDangKyChoDuyet</span>
                    </a>
                    <a asp-controller="PhanCongHuongDans" asp-action="ChoPhanCong" class="btn btn-outline-primary text-start">
                        Phân công giảng viên hướng dẫn
                    </a>
                    <a asp-controller="TienDo" asp-action="Index" class="btn btn-outline-secondary text-start">
                        Cập nhật tiến độ thực hiện
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>