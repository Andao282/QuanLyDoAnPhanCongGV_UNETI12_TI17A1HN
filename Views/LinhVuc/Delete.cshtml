@model QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.LinhVuc

@{
    ViewData["Title"] = "Xóa lĩnh vực";
}

<div class="container mt-4">

    <h2>XÓA LĨNH VỰC ĐỀ TÀI</h2>

    <div class="alert alert-danger mt-3">
        <strong>Bạn có chắc chắn muốn xóa lĩnh vực này không?</strong>
    </div>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Mã lĩnh vực
        </dt>
        <dd class="col-sm-9">
            @Model.MaLinhVuc
        </dd>

        <dt class="col-sm-3">
            Tên lĩnh vực
        </dt>
        <dd class="col-sm-9">
            @Model.TenLinhVuc
        </dd>

        <dt class="col-sm-3">
            Mô tả
        </dt>
        <dd class="col-sm-9">
            @Model.MoTa
        </dd>

        <dt class="col-sm-3">
            Trạng thái
        </dt>
        <dd class="col-sm-9">
            @Model.TrangThai
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="MaLinhVuc" />

        <button type="submit"
                class="btn btn-danger">
            Xác nhận xóa
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Hủy
        </a>

    </form>

</div>