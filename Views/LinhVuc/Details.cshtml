 @* 
Họ và tên: Đoàn Quốc Hợp
MSSV: 23103100097
Nội dung thực hiện: Module 1 - Quản lý lĩnh vực đề tài.
*@
@model QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.LinhVuc

@{
    ViewData["Title"] = "Chi tiết lĩnh vực";
}

<div class="lv-form-page">
    <div class="lv-form-header">
        <div class="lv-form-eyebrow">MODULE 01 / LINH VUC MANAGEMENT</div>
        <h1>Chi tiết <span>lĩnh vực đề tài</span></h1>
        <p>Xem thông tin và trạng thái hiện tại của lĩnh vực được chọn.</p>
    </div>

    <div class="lv-form-card">
        <div class="lv-form-card-header">
            <h2>Thông tin lĩnh vực</h2>
            <p>Thông tin được lấy từ dữ liệu lĩnh vực hiện có.</p>
        </div>

        <div class="lv-form-card-body">
            <dl class="lv-detail-list">
                <div class="lv-detail-row">
                    <dt>Mã lĩnh vực</dt>
                    <dd class="lv-detail-id">#@Model.MaLinhVuc</dd>
                </div>

                <div class="lv-detail-row">
                    <dt>Tên lĩnh vực</dt>
                    <dd>@Model.TenLinhVuc</dd>
                </div>

                <div class="lv-detail-row">
                    <dt>Mô tả</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Chưa có mô tả." : Model.MoTa)</dd>
                </div>

                <div class="lv-detail-row">
                    <dt>Trạng thái</dt>
                    <dd>
                        @if (Model.TrangThai == "HoatDong")
                        {
                            <span class="lv-detail-status">● Hoạt động</span>
                        }
                        else
                        {
                            <span class="lv-detail-status"
                                  style="color:#fbbf24;background:#f59e0b16;border-color:#f59e0b30;">
                                ● Không hoạt động
                            </span>
                        }
                    </dd>
                </div>
            </dl>

            <div class="lv-form-actions">
                <a asp-action="Edit"
                   asp-route-id="@Model.MaLinhVuc"
                   class="lv-form-btn lv-form-btn-primary">
                    Chỉnh sửa lĩnh vực
                </a>

                <a asp-action="Index"
                   class="lv-form-btn lv-form-btn-secondary">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>