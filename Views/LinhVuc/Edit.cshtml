 @* 
Họ và tên: Đoàn Quốc Hợp
MSSV: 23103100097
Nội dung thực hiện: Module 1 - Quản lý lĩnh vực đề tài.
*@
@model QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.Models.LinhVuc

@{
    ViewData["Title"] = "Sửa lĩnh vực";
}

<div class="lv-form-page">
    <div class="lv-form-header">
        <div class="lv-form-eyebrow">MODULE 01 / LINH VUC MANAGEMENT</div>
        <h1>Sửa <span>lĩnh vực đề tài</span></h1>
        <p>Cập nhật thông tin lĩnh vực và lưu lại những thay đổi của bạn.</p>
    </div>

    <div class="lv-form-card">
        <div class="lv-form-card-header">
            <h2>Thông tin cần cập nhật</h2>
            <p>Mã lĩnh vực được giữ nguyên trong quá trình chỉnh sửa.</p>
        </div>

        <div class="lv-form-card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MaLinhVuc" />

                <div asp-validation-summary="ModelOnly"
                     class="lv-form-error mb-3">
                </div>

                <div class="lv-form-group">
                    <label asp-for="TenLinhVuc" class="lv-form-label">
                        Tên lĩnh vực <span class="lv-required">*</span>
                    </label>

                    <input asp-for="TenLinhVuc"
                           class="lv-form-control"
                           placeholder="Nhập tên lĩnh vực" />

                    <span asp-validation-for="TenLinhVuc"
                          class="lv-form-error"></span>

                    <small class="lv-form-hint">
                        Đảm bảo tên lĩnh vực không bị trùng.
                    </small>
                </div>

                <div class="lv-form-group">
                    <label asp-for="MoTa" class="lv-form-label">
                        Mô tả lĩnh vực
                    </label>

                    <textarea asp-for="MoTa"
                              class="lv-form-control"
                              rows="4"
                              placeholder="Nhập mô tả lĩnh vực"></textarea>

                    <span asp-validation-for="MoTa"
                          class="lv-form-error"></span>
                </div>

                <div class="lv-form-group">
                    <label asp-for="TrangThai" class="lv-form-label">
                        Trạng thái <span class="lv-required">*</span>
                    </label>

                    <select asp-for="TrangThai" class="lv-form-control">
                        <option value="HoatDong">Hoạt động</option>
                        <option value="KhongHoatDong">Không hoạt động</option>
                    </select>

                    <span asp-validation-for="TrangThai"
                          class="lv-form-error"></span>

                    <small class="lv-form-hint">
                        Chọn trạng thái mới cho lĩnh vực.
                    </small>
                </div>

                <div class="lv-form-actions">
                    <button type="submit" class="lv-form-btn lv-form-btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-action="Index"
                       class="lv-form-btn lv-form-btn-secondary">
                        Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}