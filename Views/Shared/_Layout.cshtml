<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="DeTai" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-1"></i>UNETI - Quản Lý Đồ Án
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">

                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @* Module 3: quản lý sinh viên và đăng ký đề tài *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="m3" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Module 3 - Sinh viên
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="m3">
                                <li><a class="dropdown-item" asp-controller="DangKyDeTais" asp-action="Create">Đăng ký đề tài</a></li>
                                <li><a class="dropdown-item" asp-controller="DangKyDeTais" asp-action="Index">Lịch sử đăng ký</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="SinhViens" asp-action="Index">Quản lý sinh viên</a></li>
                            </ul>
                        </li>

                        @* Module 4: duyệt đăng ký, phân công GV, theo dõi, thống kê *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="m4" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Module 4 - Admin
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="m4">
                                <li><a class="dropdown-item" asp-controller="DuyetDangKys" asp-action="Index">Duyệt đăng ký đề tài</a></li>
                                <li><a class="dropdown-item" asp-controller="PhanCongHuongDans" asp-action="ChoPhanCong">Phân công GVHD</a></li>
                                <li><a class="dropdown-item" asp-controller="PhanCongHuongDans" asp-action="Index">Danh sách phân công</a></li>
                                <li><a class="dropdown-item" asp-controller="TienDo" asp-action="Index">Theo dõi tiến độ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
                            </ul>

                            <a class="nav-link text-dark fw-semibold" asp-area="" asp-controller="DeTai" asp-action="Index">
                                <i class="bi bi-collection-fill me-1 text-primary"></i>Danh Sách Đề Tài (6.3 - 6.8)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Chính Sách</a>

                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyDoAnPhanCongGV_UNETI12_TI17A1HN - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
